# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- 数据（体积大，且版权归原作者，不放进仓库）----
data/
dataset/
datasets/
PlantVillage-Dataset/
PlantDoc-Dataset/
*.zip
*.tar.gz

# ---- 训练产物 ----
runs/**/best.pt
runs/**/last.pt
*.pt
*.pth
*.onnx
*.ckpt
